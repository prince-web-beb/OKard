{
  "name": "okard-creator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "node scripts/orchestrate.mjs dev",
    "start": "node scripts/orchestrate.mjs start",
    "build": "pnpm -r --if-present build",
