# Copy locally to .env; never commit real values.
# REPLIT is the primary UI+API host. The Replit public web process listens on PORT=3000.
DEPLOY_TARGET=replit
PUBLIC_APP_NAME=OKard Creator
PORT=3000
API_PORT=3001
OKARD_API_URL=http://127.0.0.1:3001
# On Netlify set OKARD_API_URL to a real HTTPS backend in the dashboard,
# e.g. the API on a separate Replit deployment or Google Cloud Run.
# Do not configure a public VITE_ variable containing secrets.

# Provider ORDER is fixed: OpenRouter primary, Google Gemini secondary.
# Model slugs must be chosen deliberately in the provider dashboard, not hard-coded.
# All keys are SERVER SECRET variables. Never VITE_ or PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_APP_URL=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=
# Only turn on after budget/rate-limit/privacy controls have been reviewed.
AI_FALLBACK_ENABLED=false
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=768

# Future persistence and Google Cloud Run infrastructure:
DATABASE_URL=
REDIS_URL=
OBJECT_STORAGE_PROVIDER=
OBJECT_STORAGE_BUCKET=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=

# Cloud project synchronization (server-side only). DISABLED until all are
# provisioned, tested, and explicitly enabled. No anonymous or fake user login.
# OIDC must be a real trusted identity provider with RS256/ES256 access JWTs
# issued to OKard's API audience; never use an ID token for a different client.
OKARD_CLOUD_PROJECTS_ENABLED=false
OKARD_OIDC_ISSUER=
OKARD_OIDC_AUDIENCE=
OKARD_OIDC_JWKS_URL=
# Remote PostgreSQL requires TLS certificate verification.
# Configure a trusted PEM certificate only when using a private database CA.
OKARD_DATABASE_CA_CERT=
# Run infra/postgres/0001_okard_cloud_projects.sql with migration credentials
# before turning on cloud projects. Do not grant DDL or table DELETE to app role.
# Apply ingress-level rate limits and provision backups before release.
