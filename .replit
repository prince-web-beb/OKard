# OKard: single Replit workspace runs web (public port 3000) + internal Hono API (3001).
# Connect the GitHub repository yourself as requested; do not store secrets here.
entrypoint = "package.json"
run = "corepack pnpm dev"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "corepack pnpm install --no-frozen-lockfile && corepack pnpm build"]
run = ["sh", "-c", "corepack pnpm start"]
